{
  "name": "bill-splitter",
  "version": "0.0.0",
  "private": true,
  "description": "Bill Splitter — monorepo with Vite + TanStack Router frontend and Fastify backend",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @bill-splitter/web dev",
    "dev:api": "pnpm --filter @bill-splitter/api dev",
    "build": "pnpm -r --if-present --stream build",
    "build:turbo": "turbo run build",
    "build:web": "pnpm --filter @bill-splitter/web build",
    "build:api": "pnpm --filter @bill-splitter/api build",
    "lint": "oxlint --tsconfig ./tsconfig.base.json .",
    "lint:fix": "oxlint --fix --tsconfig ./tsconfig.base.json .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "pnpm -r --if-present --stream typecheck",
    "typecheck:turbo": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck",
    "lint:staged": "lint-staged",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitest/coverage-v8": "^5.1.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.11.13",
    "typescript": "^7.0.0",
    "vitest": "^5.1.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --tsconfig ./tsconfig.base.json",
      "oxfmt"
    ],
    "*.{css,json,jsonc,md,yaml,yml}": "oxfmt"
  },
  "packageManager": "pnpm@10.11.0"
}
