{
  "name": "bill-splitter",
  "version": "0.0.0",
  "private": true,
  "description": "Bill Splitter — monorepo with Vite + TanStack Router frontend and Fastify backend",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @bill-splitter/web dev",
    "dev:api": "pnpm --filter @bill-splitter/api dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @bill-splitter/web build",
    "build:api": "pnpm --filter @bill-splitter/api build",
    "lint": "oxlint --tsconfig ./tsconfig.base.json .",
    "lint:fix": "oxlint --fix --tsconfig ./tsconfig.base.json .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm lint && pnpm typecheck",
    "lint:staged": "lint-staged",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^7.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --tsconfig ./tsconfig.base.json",
      "oxfmt"
    ],
    "*.{css,json,jsonc,md,yaml,yml}": "oxfmt"
  },
  "packageManager": "pnpm@10.11.0"
}
